{
  "name": "votion-proxmox-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "typecheck:client": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "build": "prisma generate && npm run typecheck:client && npm run typecheck:server && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "server": "tsx server/entry.ts",
    "migrate": "tsx server/db/migrate.ts",
    "db:verify": "tsx server/db/verify.ts",
    "db:verify:fresh": "tsx server/db/verifyFresh.ts",
    "start": "npm run build && tsx server/entry.ts",
    "cleanup:legacy-db": "node scripts/cleanup-legacy-database.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@novnc/novnc": "^1.7.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tremor/react": "^3.18.7",
    "@types/multer": "^1.4.13",
    "busboy": "^1.6.0",
    "clsx": "^2.1.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "framer-motion": "^13.1.0",
    "helmet": "^8.3.0",
    "http-proxy": "^1.18.1",
    "http-proxy-middleware": "^4.2.0",
    "lucide-react": "^0.344.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "otpauth": "^9.4.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "pg-boss": "^12.29.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.12.2",
    "tailwind-merge": "^2.2.1",
    "tsx": "^4.23.12",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.17",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "postcss": "^8.4.35",
    "prisma": "^7.10.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  }
}
